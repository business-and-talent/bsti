'))
PAGE_CSS=':root{--purple:#7c3aed;--ink:#202123;--muted:#6b7280;--line:#e5e7eb;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink)}*{box-sizing:border-box}body{margin:0}main{width:min(100% - 36px,860px);margin:auto;padding:28px 0 80px}article{margin-top:36px;padding:42px;border:1px solid var(--line);border-radius:24px;box-shadow:0 14px 44px rgba(32,33,35,.07)}h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.04em}h2{margin-top:32px;padding-top:12px;border-top:1px solid var(--line)}p{line-height:1.75;color:#374151}.notice{padding:14px 16px;border:1px solid #fde68a;border-radius:12px;background:#fffbeb;color:#92400e}a{color:var(--purple)}'
def page(title,sections):
 body=''.join('<h2>'+html.escape(x[0])+'</h2>'+''.join('<p>'+html.escape(p)+'</p>' for p in x[1:]) for x in sections);return '<!doctype html><html lang="zh-Hans"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+title+'</title><style>'+PAGE_CSS+'</style></head><body><main><strong>万商万才｜BSTI</strong><article><h1>'+title+'</h1><p>版本：V0.1｜2026 年 7 月 31 日</p><div class="notice">当前为开发审阅版本。正式上线前必须补齐登记主体、联系邮箱、服务商清单及生效信息。</div>'+body+'<p><a href="./index.html">返回 BSTI 测试</a></p></article></main></body></html>'
(ROOT/'privacy.html').write_text(page('BSTI 个人信息处理规则',privacy));(ROOT/'report-usage.html').write_text(page('BSTI 测试与报告使用说明',usage));print('Founder review corrections generated.')
